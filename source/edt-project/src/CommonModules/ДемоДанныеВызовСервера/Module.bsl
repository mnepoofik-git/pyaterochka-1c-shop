КонецПроцедуры

Функция СоздатьИлиНайтиМагазин()
	Ссылка = Справочники.Магазины.НайтиПоКоду("000000001");
	Если НЕ Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;

	Объект = Справочники.Магазины.СоздатьЭлемент();
	Объект.Код = "000000001";
	Объект.Наименование = "Пятёрочка — демонстрационный магазин (данные вымышлены)";
	Объект.Адрес = "ТЕСТОВЫЙ АДРЕС — вымышленный";
	Объект.КодМагазина = "TST-0001";
	Объект.ИмяПредопределенныхДанных = "ТестовыйМагазин";
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Процедура СоздатьИлиНайтиСклад(Магазин)
	Ссылка = Справочники.Склады.НайтиПоКоду("000000001");
	Если НЕ Ссылка.Пустая() Тогда
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект.ИмяПредопределенныхДанных = "ТестовыйСклад" Тогда
			Объект.Магазин = Магазин;
			Объект.ТипСклада = "Тестовый";
			Объект.Записать();
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Объект = Справочники.Склады.СоздатьЭлемент();
	Объект.Код = "000000001";
	Объект.Наименование = "Демонстрационный склад, не реальный";
	Объект.Магазин = Магазин;
	Объект.ТипСклада = "Тестовый";
	Объект.ИмяПредопределенныхДанных = "ТестовыйСклад";
	Объект.Записать();
КонецПроцедуры

