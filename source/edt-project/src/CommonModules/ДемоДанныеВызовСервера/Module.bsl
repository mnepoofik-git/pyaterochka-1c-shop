Процедура СоздатьИлиНайтиТовар(ИмяПредопределенного, Код, Наименование, Штрихкод, Артикул, ЕдиницаИзмерения, СтавкаНДС)
	Ссылка = Справочники.Номенклатура.НайтиПоКоду(Код);
	Если НЕ Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Объект = Справочники.Номенклатура.СоздатьЭлемент();
	Объект.Код = Код;
	Объект.Наименование = Наименование;
	Объект.Штрихкод = Штрихкод;
	Объект.Артикул = Артикул;
	Объект.ЕдиницаИзмерения = ЕдиницаИзмерения;
	Объект.СтавкаНДС = СтавкаНДС;
	Объект.ИмяПредопределенныхДанных = ИмяПредопределенного;
	Объект.Записать();
КонецПроцедуры
