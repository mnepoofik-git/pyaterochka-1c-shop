Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Движения.ТоварыНаСкладах.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;
	Для Каждого СтрокаТоваров Из Товары Цикл
		ДвижениеОстатков = Движения.ТоварыНаСкладах.Добавить();
		ДвижениеОстатков.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеОстатков.Период = Дата;
		ДвижениеОстатков.Номенклатура = СтрокаТоваров.Номенклатура;
		ДвижениеОстатков.Склад = КассаККМ.Магазин;
		ДвижениеОстатков.Количество = СтрокаТоваров.Количество;
		ДвижениеПродаж = Движения.Продажи.Добавить();
		ДвижениеПродаж.Период = Дата;
		ДвижениеПродаж.Номенклатура = СтрокаТоваров.Номенклатура;
		ДвижениеПродаж.Магазин = Магазин;
		ДвижениеПродаж.Количество = СтрокаТоваров.Количество;
		ДвижениеПродаж.Сумма = СтрокаТоваров.Сумма;
	КонецЦикла;
КонецПроцедуры
