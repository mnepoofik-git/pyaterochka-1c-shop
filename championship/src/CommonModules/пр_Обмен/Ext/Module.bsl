Функция Профиль() Экспорт
    Возврат Справочники.пр_Подключения.НайтиПоКоду("PROD");
КонецФункции

Процедура Настроить(Адрес,Логин,Пароль,ВидЦеныUID="",СкладUID="") Экспорт
    Если Не РольДоступна("ПолныеПрава") Тогда ВызватьИсключение "Параметры задаёт администратор."; КонецЕсли;
    Части=РазобратьАдрес(Адрес);
    Если ПустаяСтрока(Логин) Тогда ВызватьИсключение "Укажите логин."; КонецЕсли;
    НачатьТранзакцию();
    Попытка
        Блок=Новый БлокировкаДанных; Блок.Добавить("Справочник.пр_Подключения"); Блок.Заблокировать();
        С=Профиль();
        Если С.Пустая() Тогда
            Если ПустаяСтрока(Пароль) Тогда ВызватьИсключение "Введите пароль нового подключения."; КонецЕсли;
            П=Справочники.пр_Подключения.СоздатьЭлемент(); П.Код="PROD"; П.Наименование="Производитель";
        Иначе
            П=С.ПолучитьОбъект();
            Если (П.Адрес<>Адрес Или П.Логин<>Логин) И ПустаяСтрока(Пароль) Тогда ВызватьИсключение "Введите пароль для изменённого адреса или логина."; КонецЕсли;
        КонецЕсли;
        П.Адрес=Адрес; П.Логин=Логин; П.ВидЦеныUID=ВидЦеныUID; П.СкладUID=СкладUID; П.Записать();
        Если Не ПустаяСтрока(Пароль) Тогда УстановитьПривилегированныйРежим(Истина); ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(П.Ссылка,Пароль); КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Функция РазобратьАдрес(Адрес)
    Части=СтрРазделить(СокрЛП(Адрес),"/",Ложь);
    Если Части.Количество()<4 Тогда ВызватьИсключение "Укажите полный URL сервиса standard.odata."; КонецЕсли;
    TLS=НРег(Части[0])="https:";
    Если Не TLS И НРег(Части[0])<>"http:" Тогда ВызватьИсключение "Допустимы HTTP и HTTPS."; КонецЕсли;
    Узел=СтрРазделить(Части[1],":");
    Если СтрНайти(Узел[0],"@")>0 Или Узел.Количество()>2 Тогда ВызватьИсключение "Недопустимый адрес узла."; КонецЕсли;
    Если Не TLS И НРег(Узел[0])<>"localhost" И Узел[0]<>"127.0.0.1" Тогда ВызватьИсключение "Для удаленного узла используйте HTTPS."; КонецЕсли;
    Порт=?(TLS,443,80); Если Узел.Количество()=2 Тогда Порт=Число(Узел[1]); КонецЕсли;
    Путь=""; Для И=2 По Части.Количество()-1 Цикл Путь=Путь+"/"+Части[И]; КонецЦикла;
    Если Прав(Путь,14)<>"/standard.odata" И Прав(Путь,14)<>"standard.odata" Тогда ВызватьИсключение "URL должен оканчиваться на standard.odata."; КонецЕсли;
    Возврат Новый Структура("Сервер,Порт,Путь,TLS",Узел[0],Порт,Путь,TLS);
КонецФункции

Функция Код(Текст) Экспорт
    Возврат КодироватьСтроку(Текст,СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция JSONТекст(Данные) Экспорт
    З=Новый ЗаписьJSON; З.УстановитьСтроку(); ЗаписатьJSON(З,Данные); Возврат З.Закрыть();
КонецФункции

Функция ЗапросHTTP(Метод,Ресурс,Параметры=Неопределено,Тело=Неопределено) Экспорт
    П=Профиль(); Если П.Пустая() Тогда ВызватьИсключение "Сначала сохраните параметры подключения."; КонецЕсли;
    А=РазобратьАдрес(П.Адрес);
    // Ресурс задаётся приложением относительно опубликованного корня.
    Если Лев(Ресурс,1)="/" Или СтрНайти(Ресурс,"..")>0 Или СтрНайти(Ресурс,"?")>0 Тогда ВызватьИсключение "Некорректный ресурс."; КонецЕсли;
    УстановитьПривилегированныйРежим(Истина); Секрет=ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(П); УстановитьПривилегированныйРежим(Ложь);
    Защита=Неопределено; Если А.TLS Тогда Защита=Новый ЗащищенноеСоединениеOpenSSL; КонецЕсли;
    Соединение=Новый HTTPСоединение(А.Сервер,А.Порт,П.Логин,Секрет,,10,Защита);
    Путь=А.Путь+"/"+Ресурс+"?$format=json";
    Если Параметры<>Неопределено Тогда Для Каждого Пара Из Параметры Цикл Путь=Путь+"&$"+Пара.Ключ+"="+Код(Строка(Пара.Значение)); КонецЦикла; КонецЕсли;
    З=Новый HTTPЗапрос(Путь); З.Заголовки.Вставить("Accept","application/json");
    Если Тело<>Неопределено Тогда З.Заголовки.Вставить("Content-Type","application/json; charset=utf-8"); З.УстановитьТелоИзСтроки(JSONТекст(Тело),КодировкаТекста.UTF8,ИспользованиеByteOrderMark.НеИспользовать); КонецЕсли;
    Ответ=Соединение.ВызватьHTTPМетод(Метод,З);
    Если Ответ.КодСостояния<200 Или Ответ.КодСостояния>=300 Тогда
        Причина=?(Ответ.КодСостояния=401,"проверьте логин и пароль",?(Ответ.КодСостояния=404,"ресурс не опубликован",?(Ответ.КодСостояния=403,"недостаточно прав","ошибка выполнения запроса")));
        ВызватьИсключение "HTTP "+Строка(Ответ.КодСостояния)+": "+Причина+". "+Лев(Ответ.ПолучитьТелоКакСтроку(),400);
    КонецЕсли;
    Чт=Новый ЧтениеJSON; Чт.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку()); Возврат ПрочитатьJSON(Чт,Истина);
КонецФункции

Функция Список(Ресурс,Отбор="",Поля="",Связи="",Порядок="") Экспорт
    Итог=Новый Массив; П=Новый Соответствие;
    Если Отбор<>"" Тогда П.Вставить("filter",Отбор); КонецЕсли;
    Если Поля<>"" Тогда П.Вставить("select",Поля); КонецЕсли;
    Если Связи<>"" Тогда П.Вставить("expand",Связи); КонецЕсли;
    Если Порядок<>"" Тогда П.Вставить("orderby",Порядок); КонецЕсли;
    П.Вставить("top","200"); Смещение=0;
    Пока Истина Цикл
        П.Вставить("skip",Формат(Смещение,"ЧГ=0; ЧН=0")); СтрОтвета=ЗапросHTTP("GET",Ресурс,П); Пакет=СтрОтвета.Получить("value");
        Если ТипЗнч(Пакет)<>Тип("Массив") Тогда ВызватьИсключение "OData не вернул массив value."; КонецЕсли;
        Для Каждого Стр Из Пакет Цикл Итог.Добавить(Стр); КонецЦикла;
        Если Пакет.Количество()=0 Тогда Прервать; КонецЕсли;
        Смещение=Смещение+Пакет.Количество();
        Если Пакет.Количество()<200 И СтрОтвета.Получить("odata.nextLink")=Неопределено И СтрОтвета.Получить("@odata.nextLink")=Неопределено Тогда Прервать; КонецЕсли;
    КонецЦикла;
    Возврат Итог;
КонецФункции

Процедура Публикация() Экспорт
    Если Не РольДоступна("ПолныеПрава") Тогда ВызватьИсключение "Нужны права администратора."; КонецЕсли;
    Состав=ПолучитьСоставСтандартногоИнтерфейсаOData();
    Для Каждого Имя Из СтрРазделить("Справочник.Номенклатура,Справочник.Контрагенты,Справочник.ВидыЦен,Справочник.СтруктурныеЕдиницы,Справочник.Организации,Справочник.СостоянияЗаказовПокупателей,РегистрНакопления.ЗапасыНаСкладах,РегистрСведений.ЦеныНоменклатуры,Документ.ЗаказПокупателя",",") Цикл
        МД=Метаданные.НайтиПоПолномуИмени(Имя); Если Состав.Найти(МД)=Неопределено Тогда Состав.Добавить(МД); КонецЕсли;
    КонецЦикла;
    УстановитьСоставСтандартногоИнтерфейсаOData(Состав);
КонецПроцедуры
