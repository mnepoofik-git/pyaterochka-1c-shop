Функция Создать(Строки) Экспорт
    Если Строки.Количество()=0 Тогда ВызватьИсключение "Отметьте товары и задайте количество."; КонецЕсли;
    Д=Документы.ЗаказПоставщику.СоздатьДокумент(); Д.Заполнить(Неопределено); Д.Дата=ТекущаяДатаСеанса();
    Д.Контрагент=Справочники.Контрагенты.НайтиПоНаименованию("ОфисПро Производство",Истина);
    Если Д.Контрагент.Пустая() Тогда ВызватьИсключение "Добавьте контрагента ОфисПро Производство."; КонецЕсли;
    Д.Организация=пр_Учет.Первый("Организации"); Д.СтруктурнаяЕдиница=пр_Учет.Первый("СтруктурныеЕдиницы"); Сумма=0;
    Для Каждого С Из Строки Цикл
        Если С.Количество<=0 Тогда ВызватьИсключение "Количество должно быть положительным."; КонецЕсли;
        Стр=Д.Запасы.Добавить(); Стр.Номенклатура=С.Номенклатура; Стр.ЕдиницаИзмерения=С.Номенклатура.ЕдиницаИзмерения; Стр.Количество=С.Количество; Стр.Цена=С.Цена; Стр.Сумма=Окр(Стр.Количество*Стр.Цена,2); Стр.Всего=Стр.Сумма; Сумма=Сумма+Стр.Всего;
    КонецЦикла; Д.СуммаДокумента=Сумма; Д.Записать(); Возврат Д.Ссылка;
КонецФункции

Функция Отправить(Ссылка) Экспорт
    Если Не ЗначениеЗаполнено(Ссылка) Тогда ВызватьИсключение "Сначала запишите заказ."; КонецЕсли;
    НачатьТранзакцию();
    Попытка
        Б=Новый БлокировкаДанных; Б.Добавить("Документ.ЗаказПоставщику").УстановитьЗначение("Ссылка",Ссылка); Б.Заблокировать();
        Д=Ссылка.ПолучитьОбъект(); Если ЗначениеЗаполнено(Д.пр_UIDЗаказа) Тогда ЗафиксироватьТранзакцию(); Возврат Д.пр_UIDЗаказа; КонецЕсли;
        Если Д.Запасы.Количество()=0 Тогда ВызватьИсключение "Нет позиций."; КонецЕсли;
        Метка="OfficePro-"+Строка(Ссылка.УникальныйИдентификатор());
        Совп=пр_Обмен.Список("Document_ЗаказПокупателя","Комментарий eq '"+Метка+"'","Ref_Key");
        Если Совп.Количество()>1 Тогда ВызватьИсключение "Производитель вернул несколько заказов с одинаковым ключом."; КонецЕсли;
        Если Совп.Количество()=1 Тогда ИД=Совп[0]["Ref_Key"]; Иначе
            Контр=пр_Обмен.Список("Catalog_Контрагенты","Description eq 'ОфисПро Трейд' and DeletionMark eq false","Ref_Key");
            Если Контр.Количество()<>1 Тогда ВызватьИсключение "Требуется один контрагент ОфисПро Трейд в базе производителя."; КонецЕсли;
            Товары=Новый Массив; Для Каждого С Из Д.Запасы Цикл
                Если С.Количество<=0 Или С.Цена<=0 Тогда ВызватьИсключение "Проверьте количества и закупочные цены."; КонецЕсли;
                Товары.Добавить(Новый Структура("LineNumber,Номенклатура_Key,Количество,Цена,Сумма,Всего",С.НомерСтроки,пр_Каталог.UIDТовара(С.Номенклатура),С.Количество,С.Цена,С.Сумма,С.Всего));
            КонецЦикла;
            Тело=Новый Структура("Date,Контрагент_Key,Комментарий,СуммаДокумента,Запасы",Формат(Д.Дата,"ДФ=yyyy-MM-ddTHH:mm:ss"),Контр[0]["Ref_Key"],Метка,Д.СуммаДокумента,Товары);
            Ответ=пр_Обмен.ЗапросHTTP("POST","Document_ЗаказПокупателя",,Тело); ИД=Ответ["Ref_Key"];
        КонецЕсли;
        Если Не ЗначениеЗаполнено(ИД) Тогда ВызватьИсключение "У ответа нет Ref_Key."; КонецЕсли;
        Статус=Справочники.СостоянияЗаказовПоставщикам.НайтиПоНаименованию("Отправлен",Истина);
        Если Статус.Пустая() Тогда ВызватьИсключение "Добавьте типовое состояние заказа поставщику «Отправлен» и повторите отправку."; КонецЕсли;
        Д.пр_UIDЗаказа=ИД; Д.СостояниеЗаказа=Статус; Д.Записать(); ЗафиксироватьТранзакцию(); Возврат ИД;
    Исключение
        ОтменитьТранзакцию(); ЗаписьЖурналаРегистрации("ОфисПро.Отправка",УровеньЖурналаРегистрации.Ошибка,,Ссылка,ОписаниеОшибки()); ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция Проверить(Ссылка) Экспорт
    Попытка
        Если ПустаяСтрока(Ссылка.пр_UIDЗаказа) Тогда ВызватьИсключение "Заказ ещё не отправлен."; КонецЕсли;
        ИД=Строка(Новый УникальныйИдентификатор(Ссылка.пр_UIDЗаказа)); П=Новый Соответствие; П.Вставить("select","Ref_Key,СостояниеЗаказа_Key");
        Отв=пр_Обмен.ЗапросHTTP("GET","Document_ЗаказПокупателя(guid'"+ИД+"')",П);
        Сост=Отв["СостояниеЗаказа_Key"]; Новое="Не подтвержден";
        Если ЗначениеЗаполнено(Сост) И Сост<>"00000000-0000-0000-0000-000000000000" Тогда
            Отв=пр_Обмен.ЗапросHTTP("GET","Catalog_СостоянияЗаказовПокупателей(guid'"+Строка(Новый УникальныйИдентификатор(Сост))+"')"); Новое=Отв["Description"];
        КонецЕсли;
        НачатьТранзакцию(); Попытка
            Б=Новый БлокировкаДанных; Б.Добавить("Документ.ЗаказПоставщику").УстановитьЗначение("Ссылка",Ссылка); Б.Заблокировать();
            Д=Ссылка.ПолучитьОбъект(); Старое=Д.пр_СостояниеПроизводителя;
            Если Старое<>Новое Тогда
                Текст="Заказ №"+Д.Номер+": статус изменён «"+Старое+"» → «"+Новое+"»"; Д.пр_СостояниеПроизводителя=Новое; Д.Записать();
                ЗаписьЖурналаРегистрации("ОфисПро.Состояние",УровеньЖурналаРегистрации.Информация,,Ссылка,Текст);
                Уведомить(Д,Текст);
            КонецЕсли; ЗафиксироватьТранзакцию();
        Исключение ОтменитьТранзакцию(); ВызватьИсключение; КонецПопытки;
        Возврат Новое;
    Исключение
        ЗаписьЖурналаРегистрации("ОфисПро.Состояние",УровеньЖурналаРегистрации.Ошибка,,Ссылка,ОписаниеОшибки()); ВызватьИсключение;
    КонецПопытки;
КонецФункции

Процедура Уведомить(Д,Текст)
    Получатель=Д.Автор;
    Если Не ЗначениеЗаполнено(Получатель) Тогда Возврат; КонецЕсли;
    П=Новый Структура("Пользователь,Описание,Источник,ВремяСобытия,СрокНапоминания",Получатель,Текст,Д.Ссылка,ТекущаяДатаСеанса(),ТекущаяДатаСеанса());
    Нап=НапоминанияПользователяКлиентСервер.ОписаниеНапоминания(П,Истина);
    Нап.СпособУстановкиВремениНапоминания=Перечисления.СпособыУстановкиВремениНапоминания.ВУказанноеВремя;
    Нап.Расписание=Новый ХранилищеЗначения(Неопределено);
    НапоминанияПользователяСлужебный.ПодключитьНапоминание(Нап);
КонецПроцедуры

Процедура Опросить() Экспорт
    Сейчас=ТекущаяДатаСеанса(); Если ДеньНедели(Сейчас)>5 Или Час(Сейчас)<8 Или Час(Сейчас)>=20 Тогда Возврат; КонецЕсли;
    Если пр_Обмен.Профиль().Пустая() Тогда Возврат; КонецЕсли;
    Т=пр_Учет.Данные("ВЫБРАТЬ Ссылка ИЗ Документ.ЗаказПоставщику ГДЕ пр_UIDЗаказа<>"""" И НЕ ПометкаУдаления");
    Для Каждого С Из Т Цикл Попытка Проверить(С.Ссылка); Исключение Продолжить; КонецПопытки; КонецЦикла;
КонецПроцедуры
