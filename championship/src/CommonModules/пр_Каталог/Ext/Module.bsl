Функция НайтиЛокально(UID) Экспорт
    Р=РегистрыСведений.пр_СвязкаUID.СоздатьМенеджерЗаписи(); Р.UID=UID; Р.Прочитать(); Возврат Р.Номенклатура;
КонецФункции

Функция UIDТовара(Ссылка) Экспорт
    Т=пр_Учет.Данные("ВЫБРАТЬ UID ИЗ РегистрСведений.пр_СвязкаUID ГДЕ Номенклатура=&Н",Новый Структура("Н",Ссылка));
    Если Т.Количество()<>1 Тогда ВызватьИсключение "Для позиции требуется однозначная связь с производителем: "+Ссылка; КонецЕсли; Возврат Т[0].UID;
КонецФункции

Функция Синхронизировать() Экспорт
    Если Не ПравоДоступа("Добавление",Метаданные.Справочники.Номенклатура) Тогда ВызватьИсключение "Недостаточно прав для загрузки каталога."; КонецЕсли;
    Кат=пр_Обмен.Список("Catalog_Номенклатура","DeletionMark eq false","Ref_Key,Parent_Key,Description,IsFolder,Артикул","","Ref_Key");
    // В демонстрационной УНФ могут быть другие товары. Отбираем ветви конкурса.
    Включены=Новый Соответствие; Корни=СтрРазделить("Бумажная продукция,Письменные принадлежности,Системы хранения",",");
    Для Каждого С Из Кат Цикл Если С["IsFolder"] И Корни.Найти(С["Description"])<>Неопределено И С["Parent_Key"]="00000000-0000-0000-0000-000000000000" Тогда Включены.Вставить(С["Ref_Key"],0); КонецЕсли; КонецЦикла;
    Для Глубина=1 По 4 Цикл Для Каждого С Из Кат Цикл Если Включены[С["Parent_Key"]]=Глубина-1 Тогда Включены.Вставить(С["Ref_Key"],Глубина); КонецЕсли; КонецЦикла; КонецЦикла;
    Если Включены.Количество()=0 Тогда ВызватьИсключение "У производителя не найдены три ветви каталога ОфисПро. Проверьте импорт."; КонецЕсли;
    НачатьТранзакцию();
    Попытка
        УстановитьПривилегированныйРежим(Истина);
        Б=Новый БлокировкаДанных; Б.Добавить("РегистрСведений.пр_СвязкаUID"); Б.Заблокировать();
        Всего=0;
        Для Глубина=0 По 4 Цикл
            Для Каждого С Из Кат Цикл
                ИД=С["Ref_Key"]; Если Включены[ИД]<>Глубина Тогда Продолжить; КонецЕсли;
                Род=Справочники.Номенклатура.ПустаяСсылка(); Если Глубина>0 Тогда Род=НайтиЛокально(С["Parent_Key"]); КонецЕсли;
                Н=НайтиЛокально(ИД); Название=С["Description"];
                Если Не ЗначениеЗаполнено(Н) Тогда
                    Если С["IsFolder"] Тогда Н=пр_Учет.Папка(Род,Название);
                    Иначе
                        Совп=пр_Учет.Данные("ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура ГДЕ Наименование=&Имя И НЕ ЭтоГруппа И НЕ ПометкаУдаления",Новый Структура("Имя",Название));
                        Если Совп.Количество()>1 Тогда ВызватьИсключение "Неоднозначное имя: "+Название; КонецЕсли;
                        Если Совп.Количество()=1 Тогда Н=Совп[0].Ссылка; Иначе Н=пр_Учет.Запас(Название); КонецЕсли;
                    КонецЕсли;
                    Стар=пр_Учет.Данные("ВЫБРАТЬ UID ИЗ РегистрСведений.пр_СвязкаUID ГДЕ Номенклатура=&Н",Новый Структура("Н",Н));
                    Если Стар.Количество()>0 Тогда ВызватьИсключение "Позиция уже связана с другим UID: "+Название; КонецЕсли;
                    Зап=РегистрыСведений.пр_СвязкаUID.СоздатьМенеджерЗаписи(); Зап.UID=ИД; Зап.Номенклатура=Н; Зап.Записать();
                КонецЕсли;
                О=Н.ПолучитьОбъект(); О.Наименование=Название; О.Родитель=Род; Если Не С["IsFolder"] Тогда О.Артикул=С["Артикул"]; Всего=Всего+1; КонецЕсли; О.Записать();
            КонецЦикла;
        КонецЦикла;
        П=пр_Обмен.Профиль().ПолучитьОбъект(); П.ДатаОбновления=ТекущаяДатаСеанса(); П.Записать();
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки; Возврат Всего;
КонецФункции

Функция Рынок(Поиск="",Группа=Неопределено) Экспорт
    П=пр_Обмен.Профиль(); Если П.Пустая() Тогда ВызватьИсключение "Настройте подключение."; КонецЕсли;
    ФильтрСклада=""; Если Не ПустаяСтрока(П.СкладUID) Тогда ФильтрСклада="СтруктурнаяЕдиница_Key eq guid'"+Строка(Новый УникальныйИдентификатор(П.СкладUID))+"'"; КонецЕсли;
    Ост=пр_Обмен.Список("AccumulationRegister_ЗапасыНаСкладах/Balance",ФильтрСклада);
    Вид=П.ВидЦеныUID;
    Если ПустаяСтрока(Вид) Тогда Виды=пр_Обмен.Список("Catalog_ВидыЦен","Description eq 'Закупочная' and DeletionMark eq false","Ref_Key"); Если Виды.Количество()<>1 Тогда ВызватьИсключение "Укажите UID закупочного вида цены."; КонецЕсли; Вид=Виды[0]["Ref_Key"]; КонецЕсли;
    Цены=пр_Обмен.Список("InformationRegister_ЦеныНоменклатуры/SliceLast","ВидЦен_Key eq guid'"+Строка(Новый УникальныйИдентификатор(Вид))+"'");
    Баланс=Новый Соответствие; Стоимость=Новый Соответствие;
    Для Каждого С Из Ост Цикл К=С["Номенклатура_Key"]; Кол=Баланс[К]; Баланс.Вставить(К,?(Кол=Неопределено,0,Кол)+С["КоличествоBalance"]); КонецЦикла;
    Для Каждого С Из Цены Цикл Если С["Характеристика_Key"]="00000000-0000-0000-0000-000000000000" Тогда Стоимость.Вставить(С["Номенклатура_Key"],С["Цена"]); КонецЕсли; КонецЦикла;
    Наши=пр_Учет.Остатки(); Отбор=""; Если ЗначениеЗаполнено(Группа) Тогда Отбор=" И Номенклатура В ИЕРАРХИИ (&Группа)"; КонецЕсли;
    Т=пр_Учет.Данные("ВЫБРАТЬ UID, Номенклатура, Номенклатура.Родитель КАК Группа ИЗ РегистрСведений.пр_СвязкаUID ГДЕ НЕ Номенклатура.ЭтоГруппа И НЕ Номенклатура.ПометкаУдаления"+Отбор+" УПОРЯДОЧИТЬ ПО Номенклатура.Наименование",Новый Структура("Группа",Группа));
    Для Каждого К Из СтрРазделить("Выбор,УПроизводителя,Цена,НашОстаток,Дефицит,Количество",",") Цикл Т.Колонки.Добавить(К); КонецЦикла;
    Индекс=Т.Количество()-1; Пока Индекс>=0 Цикл
        С=Т[Индекс]; Если СтрНайти(НРег(С.Номенклатура.Наименование),НРег(Поиск))=0 И Не ПустаяСтрока(Поиск) Тогда Т.Удалить(С); Индекс=Индекс-1; Продолжить; КонецЕсли;
        С.Выбор=Ложь; С.Количество=1; С.Цена=Стоимость[С.UID]; С.УПроизводителя=Баланс[С.UID]; С.НашОстаток=Наши[С.Номенклатура];
        Если С.УПроизводителя=Неопределено Тогда С.УПроизводителя=0; КонецЕсли; Если С.НашОстаток=Неопределено Тогда С.НашОстаток=0; КонецЕсли;
        С.Дефицит=С.НашОстаток=0 И С.УПроизводителя>0; Индекс=Индекс-1;
    КонецЦикла; Возврат Т;
КонецФункции
