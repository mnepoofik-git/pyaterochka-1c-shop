Функция Данные(Текст,Параметры=Неопределено) Экспорт
    З=Новый Запрос(Текст); Если Параметры<>Неопределено Тогда Для Каждого П Из Параметры Цикл З.УстановитьПараметр(П.Ключ,П.Значение); КонецЦикла; КонецЕсли;
    Возврат З.Выполнить().Выгрузить();
КонецФункции

Функция Первый(Имя) Экспорт
    Т=Данные("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник."+Имя+" ГДЕ НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО Код");
    Если Т.Количество()=0 Тогда ВызватьИсключение "Заполните справочник "+Имя; КонецЕсли; Возврат Т[0].Ссылка;
КонецФункции

Функция НайтиСоздать(Менеджер,Название) Экспорт
    С=Менеджер.НайтиПоНаименованию(Название,Истина);
    Если Не С.Пустая() Тогда Возврат С; КонецЕсли;
    О=Менеджер.СоздатьЭлемент(); О.Заполнить(Неопределено); О.Наименование=Название; О.Записать(); Возврат О.Ссылка;
КонецФункции

Функция Запас(Название) Экспорт
    С=Справочники.Номенклатура.НайтиПоНаименованию(Название,Истина);
    Если Не С.Пустая() Тогда Возврат С; КонецЕсли;
    О=Справочники.Номенклатура.СоздатьЭлемент(); О.Заполнить(Новый Структура("ТипНоменклатуры",Перечисления.ТипыНоменклатуры.Запас)); О.ТипНоменклатуры=Перечисления.ТипыНоменклатуры.Запас; О.Наименование=Название; О.Записать(); Возврат О.Ссылка;
КонецФункции

Функция КонтрольныеСтроки() Экспорт
    Т=Новый ТаблицаЗначений;
    Для Каждого К Из СтрРазделить("Наименование,Остаток,Минимум,Максимум",",") Цикл Т.Колонки.Добавить(К); КонецЦикла;
    Тексты=СтрРазделить("Ручка шариковая Office (синяя, 0.7 мм)|120|200|500;Ручка шариковая Office (чёрная, 0.7 мм)|85|150|400;Блокнот на спирали A5|10|50|150;Блокнот на спирали A4|45|30|100;Маркер текстовый Neon (жёлтый)|200|100|300;Папка-регистратор (синяя, A4, картон)|5|40|120;Папка-скоросшиватель (синяя, A4, пластик)|150|100|300;Тетрадь 48 листов клетка A5|0|80|200",";");
    Для Каждого Текст Из Тексты Цикл
        М=СтрРазделить(Текст,"|"); С=Т.Добавить(); С.Наименование=М[0]; С.Остаток=Число(М[1]); С.Минимум=Число(М[2]); С.Максимум=Число(М[3]);
    КонецЦикла; Возврат Т;
КонецФункции

Функция МаркированныйДокумент(Вид,Метка) Экспорт
    Т=Данные("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ."+Вид+" ГДЕ ВЫРАЗИТЬ(Комментарий КАК СТРОКА(200))=&М И НЕ ПометкаУдаления",Новый Структура("М",Метка));
    Если Т.Количество()>0 Тогда Возврат Т[0].Ссылка.ПолучитьОбъект(); КонецЕсли;
    Д=Документы[Вид].СоздатьДокумент(); Д.Заполнить(Неопределено); Д.Дата=ТекущаяДатаСеанса(); Д.Комментарий=Метка; Возврат Д;
КонецФункции

Процедура КонтрольныйПриход() Экспорт
    Если Не РольДоступна("ПолныеПрава") Тогда ВызватьИсключение "Требуются права администратора."; КонецЕсли;
    НачатьТранзакцию();
    Попытка
        НайтиСоздать(Справочники.СостоянияЗаказовПоставщикам,"Отправлен");
        Константы.ФункциональнаяОпцияИспользоватьСервисРасчетПотребностей.Установить(Истина);
        Организация=Первый("Организации"); Склад=Первый("СтруктурныеЕдиницы"); Поставщик=НайтиСоздать(Справочники.Контрагенты,"ОфисПро Производство");
        Д=МаркированныйДокумент("ПриходнаяНакладная","ОфисПро · контрольный приход АБП"); Д.Организация=Организация; Д.СтруктурнаяЕдиница=Склад; Д.Контрагент=Поставщик; Д.ВидОперации=Перечисления.ВидыОперацийПриходнаяНакладная.ПоступлениеОтПоставщика;
        Д.Запасы.Очистить();
        Для Каждого С Из КонтрольныеСтроки() Цикл
            Н=Запас(С.Наименование); О=Н.ПолучитьОбъект(); О.СпособПополнения=Перечисления.СпособыПополненияЗапасов.Закупка; О.СрокПополнения=3; О.Поставщик=Поставщик; О.НижняяГраницаОстатков=С.Минимум; О.ВерхняяГраницаОстатков=С.Максимум; О.Записать();
            Р=РегистрыСведений.УправлениеЗапасами.СоздатьМенеджерЗаписи(); Р.Номенклатура=Н; Р.Склад=Склад; Р.Организация=Организация; Р.МинимальныйУровеньЗапаса=С.Минимум; Р.МаксимальныйУровеньЗапаса=С.Максимум; Р.Записать();
            Если С.Остаток>0 Тогда Стр=Д.Запасы.Добавить(); Стр.Номенклатура=Н; Стр.Количество=С.Остаток; Стр.ЕдиницаИзмерения=О.ЕдиницаИзмерения; КонецЕсли;
        КонецЦикла;
        Д.Записать(РежимЗаписиДокумента.Проведение); ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Функция Остатки(Склад=Неопределено) Экспорт
    Условие=?(ЗначениеЗаполнено(Склад),"СтруктурнаяЕдиница=&Склад","");
    Т=Данные("ВЫБРАТЬ Номенклатура, СУММА(КоличествоОстаток) КАК Количество ИЗ РегистрНакопления.ЗапасыНаСкладах.Остатки(,"+Условие+") СГРУППИРОВАТЬ ПО Номенклатура",Новый Структура("Склад",Склад));
    М=Новый Соответствие; Для Каждого С Из Т Цикл М.Вставить(С.Номенклатура,С.Количество); КонецЦикла; Возврат М;
КонецФункции

Функция Потребность() Экспорт
    Склад=Первый("СтруктурныеЕдиницы"); Ост=Остатки(Склад);
    Т=Данные("ВЫБРАТЬ Номенклатура, МинимальныйУровеньЗапаса КАК Минимум, МаксимальныйУровеньЗапаса КАК Максимум ИЗ РегистрСведений.УправлениеЗапасами ГДЕ Склад=&С И Организация=&О И Номенклатура.Поставщик=&П И НЕ Номенклатура.ПометкаУдаления",Новый Структура("С,О,П",Склад,Первый("Организации"),Справочники.Контрагенты.НайтиПоНаименованию("ОфисПро Производство",Истина)));
    Т.Колонки.Добавить("НашОстаток"); Т.Колонки.Добавить("Количество");
    Для Индекс=1 По Т.Количество() Цикл
        С=Т[Т.Количество()-Индекс]; С.НашОстаток=Ост.Получить(С.Номенклатура); Если С.НашОстаток=Неопределено Тогда С.НашОстаток=0; КонецЕсли;
        С.Количество=?(С.НашОстаток<=С.Минимум,Макс(0,С.Максимум-С.НашОстаток),0);
    КонецЦикла;
    Для Каждого С Из Т.НайтиСтроки(Новый Структура("Количество",0)) Цикл Т.Удалить(С); КонецЦикла;
    Возврат Т;
КонецФункции

Функция ИмяТовара(База,Цвет,Размер,Материал) Экспорт
    Части=Новый Массив; Для Каждого Поле Из Новый Структура("Цвет,Размер,Материал",Цвет,Размер,Материал) Цикл
        Если Не ПустаяСтрока(Поле.Значение) Тогда Части.Добавить(СокрЛП(Поле.Значение)); КонецЕсли;
    КонецЦикла;
    Если Части.Количество()=0 Тогда Возврат База; ИначеЕсли Части.Количество()=1 Тогда Возврат База+" "+Части[0]; КонецЕсли;
    Возврат База+" ("+СтрСоединить(Части,", ")+")";
КонецФункции

Функция Папка(Родитель,Имя) Экспорт
    Если ПустаяСтрока(Имя) Тогда Возврат Родитель; КонецЕсли;
    С=Справочники.Номенклатура.НайтиПоНаименованию(Имя,Истина,Родитель);
    Если Не С.Пустая() Тогда Если Не С.ЭтоГруппа Тогда ВызватьИсключение "Имя занято товаром: "+Имя; КонецЕсли; Возврат С; КонецЕсли;
    О=Справочники.Номенклатура.СоздатьГруппу(); О.Родитель=Родитель; О.Наименование=Имя; О.Записать(); Возврат О.Ссылка;
КонецФункции

Функция СвойствоКатегории(Категория,Имя)
    Набор=Категория.НаборСвойств;
    Если Не ЗначениеЗаполнено(Набор) Тогда
        Н=Справочники.НаборыДополнительныхРеквизитовИСведений.СоздатьЭлемент(); Н.Наименование="ОфисПро "+Категория.Наименование; Н.Записать(); Набор=Н.Ссылка; К=Категория.ПолучитьОбъект(); К.НаборСвойств=Набор; К.Записать();
    КонецЕсли;
    Для Каждого С Из Набор.ДополнительныеРеквизиты Цикл Если С.Свойство.Заголовок=Имя Или С.Свойство.Наименование=Имя Тогда Возврат С.Свойство; КонецЕсли; КонецЦикла;
    П=ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент(); П.Наименование=Имя; П.Заголовок=Имя; П.НаборСвойств=Набор; П.ТипЗначения=Новый ОписаниеТипов("СправочникСсылка.ЗначенияСвойствОбъектов"); П.Записать();
    Н=Набор.ПолучитьОбъект(); Н.ДополнительныеРеквизиты.Добавить().Свойство=П.Ссылка; Н.Записать(); Возврат П.Ссылка;
КонецФункции

Процедура СвойствоТовара(О,Имя,Текст)
    Если ПустаяСтрока(Текст) Тогда Возврат; КонецЕсли;
    Св=СвойствоКатегории(О.КатегорияНоменклатуры,Имя);
    Зн=Справочники.ЗначенияСвойствОбъектов.НайтиПоНаименованию(Текст,Истина,,Св);
    Если Зн.Пустая() Тогда З=Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент(); З.Владелец=Св; З.Наименование=Текст; З.Записать(); Зн=З.Ссылка; КонецЕсли;
    Стр=О.ДополнительныеРеквизиты.Найти(Св,"Свойство"); Если Стр=Неопределено Тогда Стр=О.ДополнительныеРеквизиты.Добавить(); Стр.Свойство=Св; КонецЕсли; Стр.Значение=Зн;
КонецПроцедуры

Функция ЗагрузитьExcel(Путь,Картинки) Экспорт
    Если Не РольДоступна("ПолныеПрава") Тогда ВызватьИсключение "Требуются права администратора."; КонецЕсли;
    Т=Новый ТабличныйДокумент; Т.Прочитать(Путь,СпособЧтенияЗначенийТабличногоДокумента.Текст); Колонки=Новый Соответствие;
    Для Кол=1 По Т.ШиринаТаблицы Цикл Колонки.Вставить(НРег(СокрЛП(Т.Область(1,Кол).Текст)),Кол); КонецЦикла;
    Поля=СтрРазделить("Категория,Группа,Подгруппа,Подподгруппа,Артикул,Наименование,Штрихкод,Цвет,Размер,Материал,Остаток,Цена закупочная,Цена розничная",",");
    Для Каждого Имя Из Поля Цикл Если Колонки.Получить(НРег(Имя))=Неопределено Тогда ВызватьИсключение "Нет колонки "+Имя; КонецЕсли; КонецЦикла;
    НачатьТранзакцию();
    Попытка
        Д=МаркированныйДокумент("ОприходованиеЗапасов","ОфисПро · остатки производителя"); Д.Организация=Первый("Организации"); Д.СтруктурнаяЕдиница=Первый("СтруктурныеЕдиницы"); Д.Запасы.Очистить();
        Ц=МаркированныйДокумент("УстановкаЦенНоменклатуры","ОфисПро · цены каталога"); Ц.Запасы.Очистить();
        ВидЗак=НайтиСоздать(Справочники.ВидыЦен,"Закупочная"); ВидРоз=НайтиСоздать(Справочники.ВидыЦен,"Розничная"); Артикулы=Новый Соответствие; Штрихкоды=Новый Соответствие;
        Для Ряд=2 По Т.ВысотаТаблицы Цикл
            Р=Новый Соответствие; Для Каждого Имя Из Поля Цикл Р.Вставить(Имя,СокрЛП(Т.Область(Ряд,Колонки[НРег(Имя)]).Текст)); КонецЦикла;
            Арт=Р["Артикул"]; Если ПустаяСтрока(Арт) И ПустаяСтрока(Р["Наименование"]) Тогда Продолжить; КонецЕсли;
            Если ПустаяСтрока(Арт) Или Артикулы[Арт]<>Неопределено Тогда ВызватьИсключение "Пустой или повторный артикул в строке "+Ряд; КонецЕсли; Артикулы.Вставить(Арт,Истина);
            ШК=Р["Штрихкод"]; Если СтрДлина(ШК)<>13 Или Штрихкоды[ШК]<>Неопределено Тогда ВызватьИсключение "Проверьте EAN-13 в строке "+Ряд; КонецЕсли; Штрихкоды.Вставить(ШК,Истина);
            Род=Справочники.Номенклатура.ПустаяСсылка(); Для Каждого Уровень Из СтрРазделить("Группа,Подгруппа,Подподгруппа",",") Цикл Род=Папка(Род,Р[Уровень]); КонецЦикла;
            С=Справочники.Номенклатура.НайтиПоРеквизиту("Артикул",Арт); Если С.Пустая() Тогда О=Справочники.Номенклатура.СоздатьЭлемент(); О.Заполнить(Новый Структура("ТипНоменклатуры",Перечисления.ТипыНоменклатуры.Запас)); Иначе О=С.ПолучитьОбъект(); КонецЕсли;
            О.Артикул=Арт; О.ТипНоменклатуры=Перечисления.ТипыНоменклатуры.Запас; О.Родитель=Род; О.Наименование=ИмяТовара(Р["Наименование"],Р["Цвет"],Р["Размер"],Р["Материал"]); О.КатегорияНоменклатуры=НайтиСоздать(Справочники.КатегорииНоменклатуры,Р["Категория"]);
            Для Каждого Имя Из СтрРазделить("Цвет,Размер,Материал",",") Цикл СвойствоТовара(О,Имя,Р[Имя]); КонецЦикла; О.Записать();
            Б=РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи(); Б.Штрихкод=ШК; Б.Номенклатура=О.Ссылка; Б.Записать();
            Количество=Число(Р["Остаток"]); Если Количество<0 Тогда ВызватьИсключение "Отрицательный остаток."; КонецЕсли;
            Если Количество>0 Тогда Стр=Д.Запасы.Добавить(); Стр.Номенклатура=О.Ссылка; Стр.Количество=Количество; Стр.Цена=Число(Р["Цена закупочная"]); Стр.Сумма=Количество*Стр.Цена; Стр.ЕдиницаИзмерения=О.ЕдиницаИзмерения; КонецЕсли;
            Для Каждого ИмяЦены Из СтрРазделить("Цена закупочная,Цена розничная",",") Цикл Стр=Ц.Запасы.Добавить(); Стр.Номенклатура=О.Ссылка; Стр.ВидЦены=?(ИмяЦены="Цена закупочная",ВидЗак,ВидРоз); Стр.Цена=Число(Р[ИмяЦены]); Стр.ЕдиницаИзмерения=О.ЕдиницаИзмерения; КонецЦикла;
            Если Не ПустаяСтрока(Картинки) Тогда
                Ф=Новый Файл(Картинки+"/"+Арт+".png"); Если Не Ф.Существует() Тогда ВызватьИсключение "Нет изображения "+Арт+".png"; КонецЕсли;
                Сущ=Данные("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.НоменклатураПрисоединенныеФайлы ГДЕ ВладелецФайла=&Т И Наименование=&А И НЕ ПометкаУдаления",Новый Структура("Т,А",О.Ссылка,Арт));
                Если Сущ.Количество()=0 Тогда РаботаСФайлами.ДобавитьФайлСДиска(О.Ссылка,Ф.ПолноеИмя); КонецЕсли;
            КонецЕсли;
        КонецЦикла;
        Если Артикулы.Количество()=0 Тогда ВызватьИсключение "В файле нет товаров."; КонецЕсли;
        Ц.Записать(РежимЗаписиДокумента.Проведение); Д.Записать(РежимЗаписиДокумента.Проведение); ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Артикулы.Количество();
КонецФункции
