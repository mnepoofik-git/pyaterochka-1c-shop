&НаСервере
&После("ПриСозданииНаСервере")
Процедура пр_ПриСоздании(Отказ,СтандартнаяОбработка)
    Г=Элементы.Добавить("пр_ОбменОфисПро",Тип("ГруппаФормы")); Г.Вид=ВидГруппыФормы.ОбычнаяГруппа; Г.Заголовок="Производитель";
    П=Элементы.Добавить("пр_Индикатор",Тип("ПолеФормы"),Г); П.Вид=ВидПоляФормы.ПолеВвода; П.ПутьКДанным="Объект.пр_СостояниеПроизводителя"; П.Заголовок="Состояние"; П.ТолькоПросмотр=Истина;
    Для Каждого Ключ Из СтрРазделить("пр_Отправить,пр_Проверить",",") Цикл
        К=Команды.Добавить(Ключ); К.Действие=Ключ; К.Заголовок=?(Ключ="пр_Отправить","Отправить заказ","Проверить состояние"); Кн=Элементы.Добавить(Ключ+"Кнопка",Тип("КнопкаФормы"),Г); Кн.Вид=ВидКнопкиФормы.ОбычнаяКнопка; Кн.ИмяКоманды=Ключ;
    КонецЦикла; пр_Цвет();
КонецПроцедуры
&НаСервере
Процедура пр_Цвет()
    С=НРег(Объект.пр_СостояниеПроизводителя);
    Цвет=Новый Цвет(235,236,237);
    Если С="не подтвержден" Или С="не подтверждён" Тогда Цвет=Новый Цвет(255,193,193);
    ИначеЕсли С="подтвержден" Или С="подтверждён" Или С="в работе" Тогда Цвет=Новый Цвет(255,230,148);
    ИначеЕсли С="выполнен" Или С="закрыт" Тогда Цвет=Новый Цвет(176,230,188); КонецЕсли;
    Элементы.пр_Индикатор.ЦветФона=Цвет;
КонецПроцедуры
&НаКлиенте
Процедура пр_Отправить(Команда)
    Если Объект.Запасы.Количество()=0 Тогда Сообщить("Добавьте товары."); Возврат; КонецЕсли;
    ПоказатьВопрос(Новый ОписаниеОповещения("пр_Подтверждение",ЭтотОбъект),"Отправить заказ на "+Объект.Запасы.Количество()+" позиций на сумму "+Объект.СуммаДокумента+" руб.?",РежимДиалогаВопрос.ДаНет);
КонецПроцедуры
&НаКлиенте
Процедура пр_Подтверждение(Ответ,Параметры) Экспорт
    Если Ответ<>КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
    Попытка Если Не Записать() Тогда Возврат; КонецЕсли; Сообщить("UID: "+пр_Передать()); Прочитать(); Исключение Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); КонецПопытки;
КонецПроцедуры
&НаСервере
Функция пр_Передать()
    Возврат пр_Заказы.Отправить(Объект.Ссылка);
КонецФункции
&НаКлиенте
Процедура пр_Проверить(Команда)
    Попытка Если Модифицированность Тогда Сообщить("Сначала запишите заказ."); Возврат; КонецЕсли; пр_ЗапросСостояния(); Прочитать(); Исключение Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); КонецПопытки;
КонецПроцедуры
&НаСервере
Процедура пр_ЗапросСостояния()
    Объект.пр_СостояниеПроизводителя=пр_Заказы.Проверить(Объект.Ссылка); пр_Цвет();
КонецПроцедуры
