&НаСервере
Процедура ПриСозданииНаСервере(Отказ,СтандартнаяОбработка)
    Рекв=Новый Массив;
    Рекв.Добавить(Новый РеквизитФормы("Группа",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"),,"Группа"));
    Рекв.Добавить(Новый РеквизитФормы("Поиск",Новый ОписаниеТипов("Строка"),,"Поиск по наименованию"));
    Рекв.Добавить(Новый РеквизитФормы("Синхронизация",Новый ОписаниеТипов("Дата"),,"Последнее обновление"));
    Рекв.Добавить(Новый РеквизитФормы("Каталог",Новый ОписаниеТипов("ТаблицаЗначений")));
    Рекв.Добавить(Новый РеквизитФормы("Выбор",Новый ОписаниеТипов("Булево"),"Каталог","Заказать"));
    Рекв.Добавить(Новый РеквизитФормы("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"),"Каталог","Номенклатура"));
    Рекв.Добавить(Новый РеквизитФормы("Количество",Новый ОписаниеТипов("Число"),"Каталог","К заказу, шт."));
    Рекв.Добавить(Новый РеквизитФормы("Группа",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"),"Каталог","Группа"));
    Рекв.Добавить(Новый РеквизитФормы("УПроизводителя",Новый ОписаниеТипов("Число"),"Каталог","У производителя"));
    Рекв.Добавить(Новый РеквизитФормы("Цена",Новый ОписаниеТипов("Число"),"Каталог","Цена закупки"));
    Рекв.Добавить(Новый РеквизитФормы("НашОстаток",Новый ОписаниеТипов("Число"),"Каталог","Наш остаток"));
    Рекв.Добавить(Новый РеквизитФормы("Дефицит",Новый ОписаниеТипов("Булево"),"Каталог","Дефицит"));
    ИзменитьРеквизиты(Рекв);
    Э=Элементы.Добавить("Группа",Тип("ПолеФормы")); Э.Вид=ВидПоляФормы.ПолеВвода; Э.ПутьКДанным="Группа"; Э.Заголовок="Группа";
    Э=Элементы.Добавить("Поиск",Тип("ПолеФормы")); Э.Вид=ВидПоляФормы.ПолеВвода; Э.ПутьКДанным="Поиск"; Э.Заголовок="Поиск по наименованию";
    Э=Элементы.Добавить("Синхронизация",Тип("ПолеФормы")); Э.Вид=ВидПоляФормы.ПолеВвода; Э.ПутьКДанным="Синхронизация"; Э.Заголовок="Последнее обновление";
    Таб=Элементы.Добавить("Каталог",Тип("ТаблицаФормы")); Таб.ПутьКДанным="Каталог"; Таб.Заголовок="Производитель и Трейд";
    Э=Элементы.Добавить("КаталогВыбор",Тип("ПолеФормы"),Таб); Э.Вид=ВидПоляФормы.ПолеФлажка; Э.ПутьКДанным="Каталог.Выбор"; Э.Заголовок="Заказать";
    Э=Элементы.Добавить("КаталогНоменклатура",Тип("ПолеФормы"),Таб); Э.Вид=ВидПоляФормы.ПолеВвода; Э.ПутьКДанным="Каталог.Номенклатура"; Э.Заголовок="Номенклатура";
    Э.ТолькоПросмотр=Истина;
    Э=Элементы.Добавить("КаталогКоличество",Тип("ПолеФормы"),Таб); Э.Вид=ВидПоляФормы.ПолеВвода; Э.ПутьКДанным="Каталог.Количество"; Э.Заголовок="К заказу, шт.";
    Э=Элементы.Добавить("КаталогГруппа",Тип("ПолеФормы"),Таб); Э.Вид=ВидПоляФормы.ПолеВвода; Э.ПутьКДанным="Каталог.Группа"; Э.Заголовок="Группа";
    Э.ТолькоПросмотр=Истина;
    Э=Элементы.Добавить("КаталогУПроизводителя",Тип("ПолеФормы"),Таб); Э.Вид=ВидПоляФормы.ПолеВвода; Э.ПутьКДанным="Каталог.УПроизводителя"; Э.Заголовок="У производителя";
    Э.ТолькоПросмотр=Истина;
    Э=Элементы.Добавить("КаталогЦена",Тип("ПолеФормы"),Таб); Э.Вид=ВидПоляФормы.ПолеВвода; Э.ПутьКДанным="Каталог.Цена"; Э.Заголовок="Цена закупки";
    Э.ТолькоПросмотр=Истина;
    Э=Элементы.Добавить("КаталогНашОстаток",Тип("ПолеФормы"),Таб); Э.Вид=ВидПоляФормы.ПолеВвода; Э.ПутьКДанным="Каталог.НашОстаток"; Э.Заголовок="Наш остаток";
    Э.ТолькоПросмотр=Истина;
    Э=Элементы.Добавить("КаталогДефицит",Тип("ПолеФормы"),Таб); Э.Вид=ВидПоляФормы.ПолеФлажка; Э.ПутьКДанным="Каталог.Дефицит"; Э.Заголовок="Дефицит";
    Э.ТолькоПросмотр=Истина;
    Км=Команды.Добавить("ЗагрузитьКаталог"); Км.Действие="ЗагрузитьКаталог"; Км.Заголовок="Обновить каталог"; Кн=Элементы.Добавить("КнопкаЗагрузитьКаталог",Тип("КнопкаФормы")); Кн.Вид=ВидКнопкиФормы.ОбычнаяКнопка; Кн.ИмяКоманды="ЗагрузитьКаталог";
    Км=Команды.Добавить("ЦеныОстатки"); Км.Действие="ЦеныОстатки"; Км.Заголовок="Обновить остатки и цены"; Кн=Элементы.Добавить("КнопкаЦеныОстатки",Тип("КнопкаФормы")); Кн.Вид=ВидКнопкиФормы.ОбычнаяКнопка; Кн.ИмяКоманды="ЦеныОстатки";
    Км=Команды.Добавить("Заказать"); Км.Действие="Заказать"; Км.Заголовок="Сформировать заказ"; Кн=Элементы.Добавить("КнопкаЗаказать",Тип("КнопкаФормы")); Кн.Вид=ВидКнопкиФормы.ОбычнаяКнопка; Кн.ИмяКоманды="Заказать";

    П=пр_Обмен.Профиль(); Если Не П.Пустая() Тогда Синхронизация=П.ДатаОбновления; КонецЕсли;
    Правило=УсловноеОформление.Элементы.Добавить();
    Отбор=Правило.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); Отбор.ЛевоеЗначение=Новый ПолеКомпоновкиДанных("Каталог.Дефицит"); Отбор.ВидСравнения=ВидСравненияКомпоновкиДанных.Равно; Отбор.ПравоеЗначение=Истина;
    Правило.Оформление.УстановитьЗначениеПараметра("ЦветФона",Новый Цвет(255,232,199));
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьКаталог(Команда)
    Попытка
        Сообщить("Синхронизировано: "+Загрузка()); Обновление();
    Исключение Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЦеныОстатки(Команда)
    Попытка
        Обновление();
    Исключение Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура Заказать(Команда)
    Попытка
        Заказ=ЗаказНаСервере(); ПоказатьЗначение(,Заказ);
    Исключение Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); КонецПопытки;
КонецПроцедуры

&НаСервере
Функция Загрузка()
    Рез=пр_Каталог.Синхронизировать(); Синхронизация=пр_Обмен.Профиль().ДатаОбновления; Возврат Рез;
КонецФункции
&НаСервере
Процедура Обновление()
    ЗначениеВРеквизитФормы(пр_Каталог.Рынок(Поиск,Группа),"Каталог");
КонецПроцедуры
&НаСервере
Функция ЗаказНаСервере()
    Т=РеквизитФормыВЗначение("Каталог"); Для Каждого С Из Т.НайтиСтроки(Новый Структура("Выбор",Ложь)) Цикл Т.Удалить(С); КонецЦикла;
    Возврат пр_Заказы.Создать(Т);
КонецФункции
