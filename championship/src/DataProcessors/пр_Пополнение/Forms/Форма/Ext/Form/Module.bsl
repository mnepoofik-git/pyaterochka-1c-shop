&НаСервере
Процедура ПриСозданииНаСервере(Отказ,СтандартнаяОбработка)
    Рекв=Новый Массив;
    Рекв.Добавить(Новый РеквизитФормы("Рекомендации",Новый ОписаниеТипов("ТаблицаЗначений")));
    Рекв.Добавить(Новый РеквизитФормы("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"),"Рекомендации","Номенклатура"));
    Рекв.Добавить(Новый РеквизитФормы("Количество",Новый ОписаниеТипов("Число"),"Рекомендации","К заказу, шт."));
    Рекв.Добавить(Новый РеквизитФормы("НашОстаток",Новый ОписаниеТипов("Число"),"Рекомендации","Наш остаток"));
    Рекв.Добавить(Новый РеквизитФормы("Минимум",Новый ОписаниеТипов("Число"),"Рекомендации","Минимум"));
    Рекв.Добавить(Новый РеквизитФормы("Максимум",Новый ОписаниеТипов("Число"),"Рекомендации","Максимум"));
    ИзменитьРеквизиты(Рекв);
    Таб=Элементы.Добавить("Рекомендации",Тип("ТаблицаФормы")); Таб.ПутьКДанным="Рекомендации"; Таб.Заголовок="Рекомендации к закупке";
    Э=Элементы.Добавить("РекомендацииНоменклатура",Тип("ПолеФормы"),Таб); Э.Вид=ВидПоляФормы.ПолеВвода; Э.ПутьКДанным="Рекомендации.Номенклатура"; Э.Заголовок="Номенклатура";
    Э.ТолькоПросмотр=Истина;
    Э=Элементы.Добавить("РекомендацииКоличество",Тип("ПолеФормы"),Таб); Э.Вид=ВидПоляФормы.ПолеВвода; Э.ПутьКДанным="Рекомендации.Количество"; Э.Заголовок="К заказу, шт.";
    Э=Элементы.Добавить("РекомендацииНашОстаток",Тип("ПолеФормы"),Таб); Э.Вид=ВидПоляФормы.ПолеВвода; Э.ПутьКДанным="Рекомендации.НашОстаток"; Э.Заголовок="Наш остаток";
    Э.ТолькоПросмотр=Истина;
    Э=Элементы.Добавить("РекомендацииМинимум",Тип("ПолеФормы"),Таб); Э.Вид=ВидПоляФормы.ПолеВвода; Э.ПутьКДанным="Рекомендации.Минимум"; Э.Заголовок="Минимум";
    Э.ТолькоПросмотр=Истина;
    Э=Элементы.Добавить("РекомендацииМаксимум",Тип("ПолеФормы"),Таб); Э.Вид=ВидПоляФормы.ПолеВвода; Э.ПутьКДанным="Рекомендации.Максимум"; Э.Заголовок="Максимум";
    Э.ТолькоПросмотр=Истина;
    Км=Команды.Добавить("НачальныеДанные"); Км.Действие="НачальныеДанные"; Км.Заголовок="Подготовить контрольный приход"; Кн=Элементы.Добавить("КнопкаНачальныеДанные",Тип("КнопкаФормы")); Кн.Вид=ВидКнопкиФормы.ОбычнаяКнопка; Кн.ИмяКоманды="НачальныеДанные";
    Км=Команды.Добавить("Рассчитать"); Км.Действие="Рассчитать"; Км.Заголовок="Рассчитать до максимума"; Кн=Элементы.Добавить("КнопкаРассчитать",Тип("КнопкаФормы")); Кн.Вид=ВидКнопкиФормы.ОбычнаяКнопка; Кн.ИмяКоманды="Рассчитать";
    Км=Команды.Добавить("Сформировать"); Км.Действие="Сформировать"; Км.Заголовок="Создать заказ поставщику"; Кн=Элементы.Добавить("КнопкаСформировать",Тип("КнопкаФормы")); Кн.Вид=ВидКнопкиФормы.ОбычнаяКнопка; Кн.ИмяКоманды="Сформировать";
    Км=Команды.Добавить("СохранитьExcel"); Км.Действие="СохранитьExcel"; Км.Заголовок="Выгрузить Excel"; Кн=Элементы.Добавить("КнопкаСохранитьExcel",Тип("КнопкаФормы")); Кн.Вид=ВидКнопкиФормы.ОбычнаяКнопка; Кн.ИмяКоманды="СохранитьExcel";

КонецПроцедуры

&НаКлиенте
Процедура НачальныеДанные(Команда)
    Попытка
        Подготовить(); РассчитатьНаСервере();
    Исключение Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура Рассчитать(Команда)
    Попытка
        РассчитатьНаСервере();
    Исключение Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
    Попытка
        Заказ=СоздатьНаСервере(); ПоказатьЗначение(,Заказ);
    Исключение Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьExcel(Команда)
    Попытка
        ТабДок=Отчет(); ТабДок.Показать("Рекомендации к закупке");
    Исключение Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура Подготовить()
    пр_Учет.КонтрольныйПриход();
КонецПроцедуры
&НаСервере
Процедура РассчитатьНаСервере()
    ЗначениеВРеквизитФормы(пр_Учет.Потребность(),"Рекомендации");
КонецПроцедуры
&НаСервере
Функция СоздатьНаСервере()
    Т=РеквизитФормыВЗначение("Рекомендации"); Т.Колонки.Добавить("Цена"); Рынок=пр_Каталог.Рынок();
    Для Каждого С Из Т Цикл Стр=Рынок.Найти(С.Номенклатура,"Номенклатура"); Если Стр=Неопределено Или Не ЗначениеЗаполнено(Стр.Цена) Тогда ВызватьИсключение "Нет цены производителя: "+С.Номенклатура; КонецЕсли; С.Цена=Стр.Цена; КонецЦикла;
    Возврат пр_Заказы.Создать(Т);
КонецФункции
&НаСервере
Функция Отчет()
    Док=Новый ТабличныйДокумент; Индекс=1;
    Для Каждого Заг Из СтрРазделить("Номенклатура,Остаток,Минимум,Максимум,К заказу",",") Цикл Док.Область(1,Индекс).Текст=Заг; Индекс=Индекс+1; КонецЦикла;
    Индекс=2; Сумма=0; Для Каждого С Из Рекомендации Цикл Док.Область(Индекс,1).Текст=Строка(С.Номенклатура); Док.Область(Индекс,2).Значение=С.НашОстаток; Док.Область(Индекс,3).Значение=С.Минимум; Док.Область(Индекс,4).Значение=С.Максимум; Док.Область(Индекс,5).Значение=С.Количество; Сумма=Сумма+С.Количество; Индекс=Индекс+1; КонецЦикла;
    Док.Область(Индекс,1).Текст="Итого"; Док.Область(Индекс,5).Значение=Сумма; Возврат Док;
КонецФункции
