&НаСервере
Процедура ПроверкаСервера()
    Попытка П=Новый Соответствие; П.Вставить("top","1"); пр_Обмен.ЗапросHTTP("GET","Catalog_Номенклатура",П); СтатусПодключения="Подключено"; Элементы.СтатусПодключения.ЦветТекста=Новый Цвет(0,110,63);
    Исключение СтатусПодключения=КраткоеПредставлениеОшибки(ИнформацияОбОшибке()); Элементы.СтатусПодключения.ЦветТекста=Новый Цвет(174,42,45); КонецПопытки;
КонецПроцедуры
&НаСервере
Процедура Читать(Вид,Отбор,ИмяТаб,Выбрать="",Раскрыть="",Порядок="")
    М=пр_Обмен.Список(Вид,Отбор,Выбрать,Раскрыть,Порядок); Таб=ЭтотОбъект[ИмяТаб]; Таб.Очистить(); Ключи=Новый Массив;
    Для Каждого С Из М Цикл Новая=Таб.Добавить(); Для Каждого П Из С Цикл
        Инд=Ключи.Найти(П.Ключ); Если Инд=Неопределено Тогда Если Ключи.Количество()=10 Тогда Продолжить; КонецЕсли; Инд=Ключи.Количество(); Ключи.Добавить(П.Ключ); Элементы[ИмяТаб+"Кол"+Строка(Инд+1)].Заголовок=П.Ключ; КонецЕсли;
        Новая["Кол"+Строка(Инд+1)]=?(ТипЗнч(П.Значение)=Тип("Массив") Или ТипЗнч(П.Значение)=Тип("Соответствие"),пр_Обмен.JSONТекст(П.Значение),Строка(П.Значение));
    КонецЦикла; КонецЦикла; СтатусПодключения="Загружено записей: "+Строка(М.Количество());
КонецПроцедуры
&НаСервере
Функция СоздатьPOST()
    М=Новый Массив; Сумма=0;
    Для Каждого С Из Позиции Цикл Если С.Количество<=0 Или С.Цена<=0 Тогда ВызватьИсключение "Проверьте цену и количество."; КонецЕсли;
        М.Добавить(Новый Структура("LineNumber,Номенклатура,Номенклатура_Type,Количество,Цена,Сумма,Всего",М.Количество()+1,Строка(Новый УникальныйИдентификатор(С.Ключ)),"StandardODATA.Catalog_Номенклатура",С.Количество,С.Цена,С.Количество*С.Цена,С.Количество*С.Цена)); Сумма=Сумма+С.Количество*С.Цена;
    КонецЦикла;
    Если М.Количество()=0 Тогда ВызватьИсключение "Добавьте строку заказа."; КонецЕсли;
    З=Новый Структура("Date,Контрагент_Key,Запасы,СуммаДокумента",Формат(ДатаЗаказа,"ДФ=yyyy-MM-ddTHH:mm:ss"),Строка(Новый УникальныйИдентификатор(КонтрагентUID)),М,Сумма);
    О=пр_Обмен.ЗапросHTTP("POST","Document_ЗаказПокупателя",,З); Возврат "UID заказа: "+О["Ref_Key"];
КонецФункции
