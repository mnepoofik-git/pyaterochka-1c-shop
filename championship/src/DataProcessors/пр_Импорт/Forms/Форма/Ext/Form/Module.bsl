&НаСервере
Процедура ПриСозданииНаСервере(Отказ,СтандартнаяОбработка)
    Рекв=Новый Массив;
    Рекв.Добавить(Новый РеквизитФормы("Файл",Новый ОписаниеТипов("Строка"),,"Каталог Excel (путь на сервере 1С)"));
    Рекв.Добавить(Новый РеквизитФормы("Папка",Новый ОписаниеТипов("Строка"),,"Папка images (путь на сервере)"));
    ИзменитьРеквизиты(Рекв);
    Э=Элементы.Добавить("Файл",Тип("ПолеФормы")); Э.Вид=ВидПоляФормы.ПолеВвода; Э.ПутьКДанным="Файл"; Э.Заголовок="Каталог Excel (путь на сервере 1С)";
    Э=Элементы.Добавить("Папка",Тип("ПолеФормы")); Э.Вид=ВидПоляФормы.ПолеВвода; Э.ПутьКДанным="Папка"; Э.Заголовок="Папка images (путь на сервере)";
    Км=Команды.Добавить("Загрузить"); Км.Действие="Загрузить"; Км.Заголовок="Загрузить каталог"; Кн=Элементы.Добавить("КнопкаЗагрузить",Тип("КнопкаФормы")); Кн.Вид=ВидКнопкиФормы.ОбычнаяКнопка; Кн.ИмяКоманды="Загрузить";
    Км=Команды.Добавить("Опубликовать"); Км.Действие="Опубликовать"; Км.Заголовок="Настроить состав OData"; Кн=Элементы.Добавить("КнопкаОпубликовать",Тип("КнопкаФормы")); Кн.Вид=ВидКнопкиФормы.ОбычнаяКнопка; Кн.ИмяКоманды="Опубликовать";

КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
    Попытка
        Сообщить("Загружено позиций: "+Импорт());
    Исключение Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура Опубликовать(Команда)
    Попытка
        Публикация(); Сообщить("Состав стандартного OData записан.");
    Исключение Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); КонецПопытки;
КонецПроцедуры

&НаСервере
Функция Импорт()
    Возврат пр_Учет.ЗагрузитьExcel(Файл,Папка);
КонецФункции
&НаСервере
Процедура Публикация()
    пр_Обмен.Публикация();
КонецПроцедуры
